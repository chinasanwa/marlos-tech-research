# Email (SMTP) — used by app/api/contact/route.ts via lib/email.ts
# Fill these in with real credentials before going live. Until then, the
# contact form will still work end-to-end (validation, honeypot spam check,
# loading/success/error states); the API route will log a clear warning to
# the server console and skip the actual send instead of crashing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Marlos Tech Research <no-reply@marlostechresearch.com.ng>"
CONTACT_EMAIL_TO=info@marlostechresearch.com.ng

# Social media (optional) — leave any of these blank/unset to hide that
# icon in the footer and anywhere else social links are rendered. See
# lib/social-links.ts.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
